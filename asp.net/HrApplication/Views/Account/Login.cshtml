@model HrApplication.Models.LoginViewModel

@{
    ViewData["Title"] = "Login";
}


@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success" id="successAlert">
        @TempData["SuccessMessage"]
    </div>
}

<div class="centered-form">
    <div class="form-container">
        <h2>Login</h2>


<form method="post" asp-controller="Account" asp-action="Login">
    <div class="form-group">
        <label asp-for="Username">Username</label>
        <input asp-for="Username" class="form-control" />
        <span asp-validation-for="Username" class="text-danger"></span>
    </div>
    <div class="form-group position-relative">
        <label asp-for="Password">Password</label>
        <input asp-for="Password" type="password" id="password" class="form-control" />
        <i class="fa fa-eye  toggle-password" id="togglePassword"></i>
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>
    <div class="form-group" id="button">
        <input type="submit" value="Log in" class="btn btn-primary" />
    </div>


</form>
       
    </div>

   
</div>

<!-- Registration link -->
<div class="form-group text-center">
    <p>Don't have an account? <a href="@Url.Action("Register", "Account")">Create one here</a>.</p>
</div>



  




<script>
    //toggle password visibility
    document.getElementById("togglePassword").addEventListener("click", function () { 
    
        const passwordField = document.getElementById("password");
        const type = password.type === 'password' ? "text" : "password";

        passwordField.type = type;

         //toggle eye icon
      this.classList.toggle('fa-eye-slash');

    });
</script>





<style>

    #button {
        margin: 5px;
    }

    .position-relative {
        position: relative;
    }

    .form-control {
        padding-right: 40px;
    }
     .toggle-password {
        position: absolute;
        top: 70%;
        right: 10px;
        cursor: pointer;
        transform: translateY(-50%);
        font-size: 15px;
        color: #aaa;
        cursor: pointer;
        z-index: 10;
    }

    .centered-form {
        min-height: 50vh; /* Full height (100% viewport height) */
        display: flex;
        justify-content: center; /* Centers horizontally */
        align-items: center; /* Centers vertically */
    }

    .form-container {
        width: 100%;
        max-width: 400px; /* You can adjust this width as needed */
        padding: 20px;
        background-color: #fff;
        box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
        border-radius: 10px;
    }

    align-content:center;
    }
</style>