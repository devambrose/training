<style>
    .position-relative {
        position: relative;
    }

    .form-control {
        padding-right: 40px; 
    }
  

    .toggle-password {
        position: absolute;
        top: 70%;
        right: 10px;
        cursor: pointer;
        transform: translateY(-50%);
        font-size: 15px;
        color: #aaa;
        cursor: pointer;
        z-index: 10;}
        
    .centered-form{
        min-height: 60vh; /* Full height (100% viewport height) */
        display: flex;
        justify-content: center; /* Centers horizontally */
        align-items: center; /* Centers vertically */
    }

    #button {
        margin: 5px;
    }

    .form-container {
        width: 100%;
        max-width: 400px; /* You can adjust this width as needed */
        padding: 20px;
        background-color: #fff;
        box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
        border-radius: 10px;
